---
/**
 * Glifo de WhatsApp.
 *
 * Usa la silueta como máscara CSS para conservar la forma original y heredar
 * el color del botón (blanco sobre fondos verdes, verde sobre fondos claros).
 * Es decorativo: cada botón ya tiene su propio texto o aria-label.
 */
interface Props {
  size?: number;
  class?: string;
}

const { size = 20, class: clase = '' } = Astro.props;
---

<span
  class:list={['icono-wa', clase]}
  style={`--wa-size: ${size}px`}
  aria-hidden="true"
></span>

<style>
  .icono-wa {
    display: inline-block;
    flex: none;
    width: var(--wa-size);
    height: var(--wa-size);
    vertical-align: middle;
    background-color: currentColor;
    -webkit-mask: url('/whatsapp.png') center / contain no-repeat;
    mask: url('/whatsapp.png') center / contain no-repeat;
  }
</style>
