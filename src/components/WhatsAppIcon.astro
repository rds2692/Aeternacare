---
/**
 * Glifo de WhatsApp.
 *
 * Usa directamente la imagen public/whatsapp.png. En los botones oscuros se
 * invierte a blanco mediante CSS; sobre fondos claros conserva su color.
 * Es decorativo: cada botón ya tiene su propio texto o aria-label.
 */
interface Props {
  size?: number;
  class?: string;
}

const { size = 20, class: clase = '' } = Astro.props;
---

<span
  class:list={['icono-wa', clase]}
  style={`--wa-size: ${size}px`}
  aria-hidden="true"
>
  <img src="/whatsapp.png" alt="" width={size} height={size} decoding="async" />
</span>

<style>
  .icono-wa {
    display: inline-flex;
    flex: none;
    width: var(--wa-size);
    height: var(--wa-size);
    vertical-align: middle;
  }

  .icono-wa img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
</style>
