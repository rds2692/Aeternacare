---
import Icon from './Icon.astro';
import { filosofia } from '../data/contenido';
---

<section class="seccion seccion--menta" id="nosotros" aria-labelledby="filosofia-titulo">
  <div class="contenedor">
    <div class="encabezado" data-reveal>
      <span class="eyebrow">Nuestra forma de cuidar</span>
      <h2 id="filosofia-titulo">{filosofia.titulo}</h2>
      <p>{filosofia.bajada}</p>
    </div>

    <ul class="rejilla-tarjetas rejilla-tarjetas--tres" role="list">
      {
        filosofia.tarjetas.map((tarjeta, indice) => (
          <li class="tarjeta" data-reveal style={`--retardo: ${indice * 90}ms`}>
            <span class="tarjeta__numero" aria-hidden="true">
              {String(indice + 1).padStart(2, '0')}
            </span>
            <span class="tarjeta__icono" aria-hidden="true">
              <Icon name={tarjeta.icono as any} size={22} />
            </span>
            <h3>{tarjeta.titulo}</h3>
            <p class="tarjeta__texto">{tarjeta.texto}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
