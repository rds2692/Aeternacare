---
import Icon from './Icon.astro';
import CorreoProtegido from './CorreoProtegido.astro';
import WhatsAppIcon from './WhatsAppIcon.astro';
import { site, whatsappLink } from '../data/site';

interface Props {
  /** En páginas internas el bloque se comporta como formulario de contacto directo. */
  compacto?: boolean;
}

const { compacto = false } = Astro.props;
---

<section class="seccion seccion--blanca" id="contacto" aria-labelledby="contacto-titulo">
  <div class="contenedor">
    <div class="contacto__grid">
      <div class="contacto__intro">
        <h2 id="contacto-titulo" data-reveal style="--retardo: 60ms">Cuéntanos qué necesitas</h2>
        <p class="texto-plano" data-reveal style="--retardo: 120ms">
          Cada persona y cada familia tienen necesidades diferentes. Cuéntanos brevemente la
          situación de tu familiar y nuestro equipo te orientará sobre la alternativa de cuidado
          más adecuada.
        </p>

        <ul class="contacto__ventajas" data-reveal style="--retardo: 180ms">
          <li>
            <Icon name="escudo" size={18} />
            <span>Conversamos contigo antes de proponer cualquier servicio.</span>
          </li>
          <li>
            <Icon name="reloj" size={18} />
            <span>Respondemos en horario hábil, de lunes a viernes.</span>
          </li>
          <li>
            <Icon name="documento" size={18} />
            <span>Te explicamos por escrito qué incluye el cuidado y qué no.</span>
          </li>
        </ul>

        <div class="contacto__directo">
          <div>
            <p style="font-size: var(--texto-sm); color: var(--ink-muted)">
              También puedes escribirnos directamente por WhatsApp.
            </p>
          </div>
          <div class="grupo-botones">
            <a
              class="btn btn--whatsapp"
              href={whatsappLink()}
              target="_blank"
              rel="noopener"
              data-analitica={'whatsapp-' + (compacto ? 'pagina' : 'seccion-contacto')}
            >
              <WhatsAppIcon size={18} />
              Hablar por WhatsApp
            </a>
            <a class="btn btn--fantasma" href={`tel:${site.telefonoE164}`} data-analitica="telefono">
              <Icon name="telefono" size={18} />
              {site.telefonoVisible}
            </a>
          </div>
          <CorreoProtegido etiqueta="Escribir por correo" compacto />
        </div>
      </div>

      <form class="formulario" id="formulario-contacto" novalidate>
        <p class="aviso-whatsapp">
          <WhatsAppIcon size={16} />
          <span>
            Al enviar, abriremos WhatsApp con tus datos ya escritos. Revisa el mensaje y pulsa
            «Enviar» para contactarnos.
          </span>
        </p>

        <div class="campo">
          <label for="nombre">Nombre completo <span class="obligatorio">*</span></label>
          <input
            id="nombre"
            name="nombre"
            type="text"
            autocomplete="name"
            required
            aria-describedby="error-nombre"
          />
          <span class="campo__error" id="error-nombre" data-error></span>
        </div>

        <div class="campo--doble">
          <div class="campo">
            <label for="telefono">Teléfono / WhatsApp <span class="obligatorio">*</span></label>
            <input
              id="telefono"
              name="telefono"
              type="tel"
              inputmode="tel"
              autocomplete="tel"
              placeholder="+56 9 1234 5678"
              required
              aria-describedby="error-telefono"
            />
            <span class="campo__error" id="error-telefono" data-error></span>
          </div>

          <div class="campo">
            <label for="correo">Correo electrónico</label>
            <input
              id="correo"
              name="correo"
              type="email"
              autocomplete="email"
              placeholder="nombre@correo.cl"
              aria-describedby="error-correo"
            />
            <span class="campo__error" id="error-correo" data-error></span>
          </div>
        </div>

        <div class="campo">
          <label for="ayuda">¿Qué tipo de ayuda necesitas?</label>
          <select id="ayuda" name="ayuda">
            <option value="">Selecciona una opción</option>
            <option>Acompañamiento y compañía</option>
            <option>Apoyo en actividades diarias</option>
            <option>Supervisión y bienestar</option>
            <option>Turnos diurnos</option>
            <option>Turnos de 24 horas</option>
            <option>Aún no lo sé, necesito orientación</option>
          </select>
        </div>

        <div class="campo">
          <label for="paraquien">¿Para quién es el servicio?</label>
          <select id="paraquien" name="paraquien">
            <option value="">Selecciona una opción</option>
            <option>Para mi madre</option>
            <option>Para mi padre</option>
            <option>Para otro familiar</option>
            <option>Para otra persona</option>
          </select>
        </div>

        <div class="campo--doble">
          <div class="campo">
            <label for="profesional">Profesional que necesitas <span class="obligatorio">*</span></label>
            <select id="profesional" name="profesional" required aria-describedby="error-profesional">
              <option value="">Selecciona una opción</option>
              <option>Cuidadora</option>
              <option>TENS</option>
              <option>Enfermera</option>
              <option>Técnico kinesiólogo</option>
              <option>No lo sé, necesito orientación</option>
            </select>
            <span class="campo__error" id="error-profesional" data-error></span>
          </div>

          <div class="campo">
            <label for="turno">Modalidad de turno <span class="obligatorio">*</span></label>
            <select id="turno" name="turno" required aria-describedby="error-turno">
              <option value="">Selecciona una opción</option>
              <option>Diurno</option>
              <option>Nocturno</option>
              <option>24 horas (día y noche)</option>
            </select>
            <span class="campo__error" id="error-turno" data-error></span>
          </div>
        </div>

        <div class="campo--doble">
          <div class="campo">
            <label for="horas">Horas por turno <span class="obligatorio">*</span></label>
            <input id="horas" name="horas" type="number" min="2" max="24" step="1" placeholder="Ej. 8" required aria-describedby="error-horas" />
            <span class="campo__error" id="error-horas" data-error></span>
          </div>

          <div class="campo">
            <label for="comuna">Comuna del servicio <span class="obligatorio">*</span></label>
            <select id="comuna" name="comuna" required aria-describedby="error-comuna">
              <option value="">Selecciona una comuna</option>
              {site.areaServida.map((comuna) => <option>{comuna}</option>)}
            </select>
            <span class="campo__error" id="error-comuna" data-error></span>
          </div>
        </div>

        <div class="campo--doble">
          <div class="campo">
            <label for="fecha-inicio">Fecha de inicio <span class="obligatorio">*</span></label>
            <input id="fecha-inicio" name="fechaInicio" type="date" required aria-describedby="error-fecha-inicio" />
            <span class="campo__error" id="error-fecha-inicio" data-error></span>
          </div>

          <div class="campo">
            <label for="fecha-termino">Fecha de término</label>
            <input id="fecha-termino" name="fechaTermino" type="date" aria-describedby="error-fecha-termino" />
            <span class="campo__error" id="error-fecha-termino" data-error></span>
          </div>
        </div>

        <fieldset class="selector-dias">
          <legend>Días de la semana</legend>
          <p class="ayuda">Selecciona los días en que necesitas el servicio.</p>
          <div class="selector-dias__atajos">
            <button type="button" class="dia-btn dia-btn--atajo" data-patron="lunes-viernes">Lunes a viernes</button>
            <button type="button" class="dia-btn dia-btn--atajo" data-patron="lunes-domingo">Lunes a domingo</button>
          </div>
          <div class="selector-dias__botones" role="group" aria-label="Días de la semana">
            {['Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado', 'Domingo'].map((dia) => (
              <button type="button" class="dia-btn" data-dia={dia} aria-pressed="false">{dia}</button>
            ))}
          </div>
          <p class="selector-dias__resumen" id="dias-resumen" aria-live="polite">No has seleccionado días.</p>
        </fieldset>

        <label class="consentimiento consentimiento--urgencia" for="urgencia">
          <input id="urgencia" name="urgencia" type="checkbox" />
          <span>Mi solicitud es urgente y necesito orientación prioritaria.</span>
        </label>

        <div class="campo">
          <label for="mensaje">Cuéntanos brevemente</label>
          <textarea
            id="mensaje"
            name="mensaje"
            rows={4}
            placeholder="Rutina, nivel de autonomía, horarios que necesitas y cualquier detalle que nos ayude a orientarte."
          ></textarea>
          <span class="ayuda"
            >Evita escribir diagnósticos o datos médicos detallados; eso lo conversamos de forma
            reservada.</span
          >
        </div>

        <label class="consentimiento" for="consentimiento-datos">
          <input id="consentimiento-datos" name="consentimiento" type="checkbox" required />
          <span>
            Acepto que Aeterna Care use estos datos para contactarme y orientarme sobre sus
            servicios, según el <a href="/privacidad/">aviso de privacidad</a>.
            <span class="obligatorio">*</span>
          </span>
        </label>
        <span class="campo__error" id="error-consentimiento" data-error></span>

        {/* Campo trampa para bots: invisible y sin foco. */}
        <div class="sr-only" aria-hidden="true">
          <label for="empresa">No completar</label>
          <input id="empresa" name="empresa" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div class="formulario__pie">
          <button class="btn btn--primario btn--grande btn--bloque" type="submit">
            <WhatsAppIcon size={18} />
            Enviar por WhatsApp
          </button>
          <p class="formulario__estado" id="formulario-estado" role="status" aria-live="polite"></p>
          <p class="ayuda">
            Se abrirá WhatsApp con el resumen de tus datos. No se envía nada hasta que confirmes el
            mensaje, y no se realiza ningún cobro ni se activa un servicio.
          </p>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  import { registrarConversion } from '../scripts/medicion';
  import { site } from '../data/site';

  const formulario = document.getElementById('formulario-contacto') as HTMLFormElement | null;

  if (formulario) {
    const estado = document.getElementById('formulario-estado');

    const marcarError = (campo: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement, mensaje: string) => {
      campo.setAttribute('aria-invalid', 'true');
      const salida = document.querySelector(`#error-${campo.id}`);
      if (salida) salida.textContent = mensaje;
    };

    const limpiarError = (campo: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement) => {
      campo.removeAttribute('aria-invalid');
      const salida = document.querySelector(`#error-${campo.id}`);
      if (salida) salida.textContent = '';
    };

    const validar = (): boolean => {
      let ok = true;
      const obligatorios = formulario.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[required]');

      obligatorios.forEach((campo) => {
        limpiarError(campo);
        if (campo.type === 'checkbox' && !campo.checked) {
          marcarError(campo, 'Necesitamos tu autorización para contactarte.');
          ok = false;
        } else if (campo.type !== 'checkbox' && !campo.value.trim()) {
          marcarError(campo, 'Este campo es obligatorio.');
          ok = false;
        }
      });

      const telefono = formulario.querySelector<HTMLInputElement>('#telefono');
      if (telefono && telefono.value.trim() && telefono.value.replace(/\D/g, '').length < 8) {
        marcarError(telefono, 'Revisa el número: parece incompleto.');
        ok = false;
      }

      const correo = formulario.querySelector<HTMLInputElement>('#correo');
      if (correo && correo.value.trim() && !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(correo.value)) {
        marcarError(correo, 'Revisa el correo electrónico.');
        ok = false;
      }

      const horas = formulario.querySelector<HTMLInputElement>('#horas');
      if (horas && horas.value && (Number(horas.value) < 2 || Number(horas.value) > 24)) {
        marcarError(horas, 'Indica entre 2 y 24 horas por turno.');
        ok = false;
      }

      const inicio = formulario.querySelector<HTMLInputElement>('#fecha-inicio');
      const termino = formulario.querySelector<HTMLInputElement>('#fecha-termino');
      if (inicio?.value && termino?.value && termino.value < inicio.value) {
        marcarError(termino, 'La fecha de término debe ser posterior al inicio.');
        ok = false;
      }

      return ok;
    };

    const resumenTexto = (datos: FormData): string => {
      const lineas = [
        'Hola, quisiera recibir orientación sobre los servicios de cuidado.',
        '',
        `Nombre: ${datos.get('nombre')}`,
        `Teléfono: ${datos.get('telefono')}`,
      ];
      const correo = String(datos.get('correo') ?? '').trim();
      const ayuda = String(datos.get('ayuda') ?? '').trim();
      const paraQuien = String(datos.get('paraquien') ?? '').trim();
      const profesional = String(datos.get('profesional') ?? '').trim();
      const turno = String(datos.get('turno') ?? '').trim();
      const horas = String(datos.get('horas') ?? '').trim();
      const comuna = String(datos.get('comuna') ?? '').trim();
      const fechaInicio = String(datos.get('fechaInicio') ?? '').trim();
      const fechaTermino = String(datos.get('fechaTermino') ?? '').trim();
      const dias = Array.from(formulario.querySelectorAll<HTMLButtonElement>('[data-dia][aria-pressed="true"]'))
        .map((boton) => boton.dataset.dia)
        .filter(Boolean)
        .join(', ');
      const mensaje = String(datos.get('mensaje') ?? '').trim();

      if (correo) lineas.push(`Correo: ${correo}`);
      if (ayuda) lineas.push(`Tipo de ayuda: ${ayuda}`);
      if (paraQuien) lineas.push(`Para quién: ${paraQuien}`);
      if (profesional) lineas.push(`Profesional: ${profesional}`);
      if (turno) lineas.push(`Turno: ${turno}`);
      if (horas) lineas.push(`Horas por turno: ${horas}`);
      if (comuna) lineas.push(`Comuna: ${comuna}`);
      if (fechaInicio) lineas.push(`Fecha de inicio: ${fechaInicio}`);
      if (fechaTermino) lineas.push(`Fecha de término: ${fechaTermino}`);
      if (dias) lineas.push(`Días solicitados: ${dias}`);
      if (datos.get('urgencia')) lineas.push('Solicitud urgente: sí');
      if (mensaje) lineas.push('', mensaje);
      if (datos.get('consentimiento')) {
        lineas.push(
          '',
          'Autorizo el contacto y el tratamiento de mis datos según el aviso de privacidad.',
        );
      }

      return lineas.join('\n');
    };

    formulario.addEventListener('submit', async (evento) => {
      evento.preventDefault();

      if (estado) {
        estado.textContent = '';
        estado.removeAttribute('data-tipo');
      }

      if (!validar()) {
        const primero = formulario.querySelector('[aria-invalid="true"]');
        (primero as HTMLElement | null)?.focus();
        if (estado) {
          estado.textContent = 'Revisa los campos marcados para poder continuar.';
          estado.dataset.tipo = 'error';
        }
        return;
      }

      const datos = new FormData(formulario);
      const url = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(resumenTexto(datos))}`;

      registrarConversion('formulario-whatsapp');

      const ventana = window.open(url, '_blank');
      if (ventana) ventana.opener = null;

      if (estado) {
        if (ventana) {
          estado.textContent =
            'Abrimos WhatsApp con tus datos. Revisa el mensaje y pulsa «Enviar» para completar el contacto.';
          estado.dataset.tipo = 'ok';
        } else {
          const enlace = document.createElement('a');
          enlace.href = url;
          enlace.target = '_blank';
          enlace.rel = 'noopener';
          enlace.className = 'btn btn--whatsapp';
          enlace.textContent = 'Abrir WhatsApp con mis datos';
          estado.replaceChildren(
            document.createTextNode('No pudimos abrir WhatsApp automáticamente. '),
            enlace,
          );
          estado.dataset.tipo = 'error';
        }
      }
    });

    formulario.addEventListener('input', (evento) => {
      const objetivo = evento.target as HTMLInputElement;
      if (objetivo.matches('input, textarea, select')) limpiarError(objetivo);
    });

    const botonesDias = Array.from(formulario.querySelectorAll<HTMLButtonElement>('[data-dia]'));
    const resumenDias = document.getElementById('dias-resumen');
    const actualizarDias = () => {
      const seleccionados = botonesDias.filter((boton) => boton.getAttribute('aria-pressed') === 'true');
      if (resumenDias) {
        resumenDias.textContent = seleccionados.length
          ? `Días seleccionados: ${seleccionados.map((boton) => boton.dataset.dia).join(', ')}.`
          : 'No has seleccionado días.';
      }
    };

    const seleccionarDias = (dias: string[]) => {
      botonesDias.forEach((boton) => {
        boton.setAttribute('aria-pressed', String(dias.includes(boton.dataset.dia ?? '')));
      });
      actualizarDias();
    };

    botonesDias.forEach((boton) => {
      boton.addEventListener('click', () => {
        boton.setAttribute('aria-pressed', String(boton.getAttribute('aria-pressed') !== 'true'));
        actualizarDias();
      });
    });

    formulario.querySelectorAll<HTMLButtonElement>('[data-patron]').forEach((boton) => {
      boton.addEventListener('click', () => {
        seleccionarDias(
          boton.dataset.patron === 'lunes-domingo'
            ? ['Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado', 'Domingo']
            : ['Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes'],
        );
      });
    });
  }
</script>
