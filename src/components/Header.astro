---
import Icon from './Icon.astro';
import { navPrincipal, whatsappLink } from '../data/site';

interface Props {
  /** Ruta actual, para marcar el enlace activo. */
  ruta?: string;
}

const { ruta = '/' } = Astro.props;
/** Marca el enlace activo cuando la página actual pertenece a esa sección. */
const estaActivo = (href: string) =>
  href === '/blog/' ? ruta.startsWith('/blog') : ruta === href;
---

<header class="header" id="header">
  <div class="contenedor header__inner">
    <a class="logo" href="/" aria-label="Aeterna Care, ir al inicio">
      <svg width="34" height="34" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
        <circle cx="20" cy="20" r="19" fill="none" stroke="#79BFAF" stroke-width="1.4" opacity="0.55"></circle>
        <path
          d="M20 30.5S9.5 24.2 9.5 16.9A6 6 0 0 1 20 13.2a6 6 0 0 1 10.5 3.7C30.5 24.2 20 30.5 20 30.5Z"
          fill="none"
          stroke="#7869B8"
          stroke-width="1.7"
          stroke-linejoin="round"></path>
      </svg>
      <span class="logo__texto">
        <span class="logo__nombre">Aeterna Care</span>
        <span class="logo__bajada">Cuidado en casa</span>
      </span>
    </a>

    <nav class="nav" aria-label="Navegación principal">
      <ul class="nav__lista">
        {
          navPrincipal.map((item) => (
            <li>
              <a
                class="nav__enlace"
                href={item.href}
                aria-current={estaActivo(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header__acciones">
      <a class="btn btn--primario header__cta" href="/contacto/">Solicitar orientación</a>
      <button
        class="menu-btn"
        type="button"
        id="menu-btn"
        aria-expanded="false"
        aria-controls="menu-panel"
        aria-label="Abrir menú de navegación"
      >
        <Icon name="menu" size={22} />
      </button>
    </div>
  </div>

  <div class="menu-panel" id="menu-panel" data-abierto="false">
    <ul class="menu-panel__lista">
      {
        navPrincipal.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))
      }
      <li class="menu-panel__cta">
        <a class="btn btn--primario btn--bloque" href="/contacto/">Solicitar orientación</a>
      </li>
      <li class="menu-panel__cta">
        <a
          class="btn btn--whatsapp btn--bloque"
          href={whatsappLink()}
          target="_blank"
          rel="noopener"
        >
          <Icon name="whatsapp" size={18} />
          Hablar por WhatsApp
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const header = document.getElementById('header');
  const boton = document.getElementById('menu-btn');
  const panel = document.getElementById('menu-panel');

  // Header translúcido al hacer scroll.
  if (header) {
    const alScroll = () => {
      header.classList.toggle('header--fijo', window.scrollY > 12);
    };
    alScroll();
    window.addEventListener('scroll', alScroll, { passive: true });
  }

  // Menú móvil accesible.
  if (boton && panel) {
    const abrir = (estado: boolean) => {
      panel.dataset.abierto = String(estado);
      boton.setAttribute('aria-expanded', String(estado));
      boton.setAttribute('aria-label', estado ? 'Cerrar menú de navegación' : 'Abrir menú de navegación');
      boton.innerHTML = estado
        ? '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12"/><path d="M18 6L6 18"/></svg>'
        : '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M4 7.5h16"/><path d="M4 12h16"/><path d="M4 16.5h16"/></svg>';
    };

    boton.addEventListener('click', () => {
      abrir(panel.dataset.abierto !== 'true');
    });

    panel.addEventListener('click', (evento) => {
      if ((evento.target as HTMLElement).closest('a')) abrir(false);
    });

    document.addEventListener('keydown', (evento) => {
      if (evento.key === 'Escape' && panel.dataset.abierto === 'true') {
        abrir(false);
        boton.focus();
      }
    });
  }
</script>
