---
import Icon from './Icon.astro';
import WhatsAppIcon from './WhatsAppIcon.astro';
import { navPrincipal, navGrupos, whatsappLink } from '../data/site';

interface Props {
  /** Ruta actual, para marcar el enlace activo. */
  ruta?: string;
}

const { ruta = '/' } = Astro.props;
/** Marca el enlace activo cuando la página actual pertenece a esa sección. */
const estaActivo = (href: string) =>
  href === '/blog/' ? ruta.startsWith('/blog') : ruta === href;
---

<header class="header" id="header">
  <div class="contenedor header__inner">
    <a class="logo" href="/" aria-label="Aeterna Care, ir al inicio">
      <picture>
        <source srcset="/img/logo-aeterna-emblema.webp" type="image/webp" />
        <img
          class="logo__marca"
          src="/img/logo-aeterna-emblema.png"
          width="46"
          height="46"
          alt=""
          decoding="async"
        />
      </picture>
      <span class="logo__texto">
        <span class="logo__nombre">Aeterna Care</span>
        <span class="logo__bajada">Cuidado en casa</span>
      </span>
    </a>

    <nav class="nav" aria-label="Navegación principal">
      <ul class="nav__lista">
        {navGrupos.map((grupo) => (
          <li class="nav__grupo">
            <details>
              <summary class="nav__enlace">{grupo.label}<span aria-hidden="true">⌄</span></summary>
              <ul class="nav__submenu">
                {grupo.items.map((item) => (
                  <li><a href={item.href} aria-current={estaActivo(item.href) ? 'page' : undefined}>{item.label}</a></li>
                ))}
              </ul>
            </details>
          </li>
        ))}
        {navPrincipal.filter((item) => ['Blog', 'Contacto'].includes(item.label)).map((item) => (
          <li>
            <a class="nav__enlace" href={item.href} aria-current={estaActivo(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header__acciones">
      <a class="btn btn--primario header__cta" href="/contacto/">Solicitar orientación</a>
      <button
        class="menu-btn"
        type="button"
        id="menu-btn"
        aria-expanded="false"
        aria-controls="menu-panel"
        aria-label="Abrir menú de navegación"
      >
        <Icon name="menu" size={22} />
      </button>
    </div>
  </div>

  <div class="menu-panel" id="menu-panel" data-abierto="false">
    <ul class="menu-panel__lista">
      {navGrupos.map((grupo) => (
        <li>
          <details class="menu-panel__grupo">
            <summary>{grupo.label}</summary>
            <ul>
              {grupo.items.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
            </ul>
          </details>
        </li>
      ))}
      {navPrincipal.filter((item) => ['Blog', 'Contacto'].includes(item.label)).map((item) => (
        <li><a href={item.href}>{item.label}</a></li>
      ))}
      <li class="menu-panel__cta">
        <a class="btn btn--primario btn--bloque" href="/contacto/">Solicitar orientación</a>
      </li>
      <li class="menu-panel__cta">
        <a
          class="btn btn--whatsapp btn--bloque"
          href={whatsappLink()}
          target="_blank"
          rel="noopener"
        >
          <WhatsAppIcon size={18} />
          Hablar por WhatsApp
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const header = document.getElementById('header');
  const boton = document.getElementById('menu-btn');
  const panel = document.getElementById('menu-panel');

  // Header translúcido al hacer scroll.
  if (header) {
    const alScroll = () => {
      header.classList.toggle('header--fijo', window.scrollY > 12);
    };
    alScroll();
    window.addEventListener('scroll', alScroll, { passive: true });
  }

  // Menú móvil accesible.
  if (boton && panel) {
    const abrir = (estado: boolean) => {
      panel.dataset.abierto = String(estado);
      boton.setAttribute('aria-expanded', String(estado));
      boton.setAttribute('aria-label', estado ? 'Cerrar menú de navegación' : 'Abrir menú de navegación');
      boton.innerHTML = estado
        ? '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12"/><path d="M18 6L6 18"/></svg>'
        : '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M4 7.5h16"/><path d="M4 12h16"/><path d="M4 16.5h16"/></svg>';
    };

    boton.addEventListener('click', () => {
      abrir(panel.dataset.abierto !== 'true');
    });

    panel.addEventListener('click', (evento) => {
      if ((evento.target as HTMLElement).closest('a')) abrir(false);
    });

    document.addEventListener('keydown', (evento) => {
      if (evento.key === 'Escape' && panel.dataset.abierto === 'true') {
        abrir(false);
        boton.focus();
      }
    });
  }

  // Menús desplegables: un solo grupo abierto a la vez.
  const gruposDesplegables = Array.from(
    document.querySelectorAll<HTMLDetailsElement>('.nav__grupo details, .menu-panel__grupo'),
  );

  const cerrarOtros = (actual: HTMLDetailsElement) => {
    gruposDesplegables.forEach((grupo) => {
      if (grupo !== actual) grupo.open = false;
    });
  };

  gruposDesplegables.forEach((grupo) => {
    const resumen = grupo.querySelector('summary');
    resumen?.addEventListener('click', (evento) => {
      evento.preventDefault();
      const seAbrira = !grupo.open;
      cerrarOtros(grupo);
      grupo.open = seAbrira;
    });

    // En escritorio, abandonar el área completa del menú lo cierra.
    grupo.addEventListener('mouseleave', () => {
      if (window.matchMedia('(min-width: 1024px)').matches) grupo.open = false;
    });
  });

  document.addEventListener('pointerdown', (evento) => {
    const objetivo = evento.target as Node;
    if (!gruposDesplegables.some((grupo) => grupo.contains(objetivo))) {
      gruposDesplegables.forEach((grupo) => {
        grupo.open = false;
      });
    }
  });
</script>
