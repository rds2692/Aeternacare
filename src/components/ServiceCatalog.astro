---
import { catalogoServicios } from '../data/contenido';
import { paginasServicios } from '../data/landing';

interface Props {
  /** Prefijo de atribución para los CTA del catálogo. */
  origen?: string;
  /** En la página comercial los grupos se muestran abiertos por defecto. */
  abierto?: boolean;
}

const { origen = 'precios', abierto = false } = Astro.props;
const servicioPorSlug = new Map(
  paginasServicios.map((servicio) => [servicio.slug, servicio]),
);
---

<section class="seccion seccion--suave" id="valores" aria-labelledby="valores-titulo">
  <div class="contenedor">
    <div class="encabezado" data-reveal>
      <h2 id="valores-titulo">{catalogoServicios.titulo}</h2>
      <p>{catalogoServicios.bajada}</p>
    </div>

    <div class="catalogo-servicios" data-reveal>
      {
        catalogoServicios.grupos.map((grupo) => (
          <details class="catalogo-servicios__grupo" open={abierto}>
            <summary>
              <span>
                <strong><a href={`/servicios/${grupo.slug}/`}>{grupo.titulo}</a></strong>
                <small>{grupo.descripcion}</small>
              </span>
              <span class="catalogo-servicios__signo" aria-hidden="true">+</span>
            </summary>
            <ul>
              {grupo.servicios.map((servicio) => (
                <li>
                  <span>{servicio.nombre}</span>
                  <strong>{servicio.precio}</strong>
                </li>
              ))}
            </ul>
            <a
              class="btn btn--secundario catalogo-servicios__cta"
              href={`/contacto/?servicio=${servicioPorSlug.get(grupo.slug)?.cotizacion ?? ''}&origen=${origen}-${grupo.slug}#formulario-contacto`}
              data-analitica={`cotizar-${origen}-${grupo.slug}`}
              data-servicio={servicioPorSlug.get(grupo.slug)?.cotizacion}
            >
              {servicioPorSlug.get(grupo.slug)?.ctaCotizacion ?? 'Cotizar'}
            </a>
          </details>
        ))
      }
    </div>

    <p class="nota-alcance" data-reveal>{catalogoServicios.nota}</p>
    <div class="grupo-botones">
      <a
        class="btn btn--primario btn--grande"
        href={`/contacto/?origen=${origen}-catalogo#formulario-contacto`}
        data-analitica={`cotizar-${origen}-catalogo`}
      >Solicitar cotización</a>
      <a class="btn btn--secundario btn--grande" href="/blog/cuanto-cuesta-cuidado-adulto-mayor-santiago/">
        Entender los factores del precio
      </a>
    </div>
  </div>
</section>
