---
import { site, navPrincipal, navLegal, whatsappLink, telLink } from '../data/site';
import CorreoProtegido from './CorreoProtegido.astro';

const anio = new Date().getFullYear();
const redes = Object.entries(site.redes).filter(([, url]) => url);
---

<footer class="footer">
  <div class="contenedor">
    <div class="footer__grid">
      <div class="footer__marca">
        <span class="footer__logo">
          <picture>
            <source srcset="/img/logo-aeterna-care.webp" type="image/webp" />
            <img
              src="/img/logo-aeterna-care.png"
              width="286"
              height="240"
              alt="Aeterna Care, cuidado de adultos mayores en casa"
              loading="lazy"
              decoding="async"
            />
          </picture>
        </span>
        <p>
          Cuidado profesional y humano en el hogar. Acompañamiento para adultos mayores en
          Santiago, con atención cercana y adaptada a cada familia.
        </p>
        <p>
          <a href={telLink} data-analitica="telefono-footer">{site.telefonoVisible}</a>
        </p>
        <CorreoProtegido />
      </div>

      <div>
        <h2 class="footer__titulo">Navegación</h2>
        <ul class="footer__lista">
          {navPrincipal.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          <li>
            <a href={whatsappLink()} target="_blank" rel="noopener" data-analitica="whatsapp-footer">
              WhatsApp
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h2 class="footer__titulo">Datos legales</h2>
        <ul class="footer__lista">
          <li>{site.nombreLegal || site.nombre}</li>
          {navLegal.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </div>
    </div>

    <div class="footer__legal">
      <p>
        {site.nombre} · Sitio informativo; no constituye asesoría médica ni reemplaza la indicación
        de un profesional de la salud.
      </p>
      <p>
        © {anio} {site.nombre}. Todos los derechos reservados.
        {redes.length > 0 && (
          <>
            {' '}
            {redes.map(([nombre, url]) => (
              <a href={url} target="_blank" rel="noopener">
                {nombre}
              </a>
            ))}
          </>
        )}
      </p>
    </div>
  </div>
</footer>
