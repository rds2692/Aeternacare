---
import Icon from './Icon.astro';
import { servicios } from '../data/contenido';
---

<section class="seccion seccion--blanca" id="servicios" aria-labelledby="servicios-titulo">
  <div class="contenedor">
    <div class="encabezado" data-reveal>
      <h2 id="servicios-titulo">{servicios.titulo}</h2>
      <p>{servicios.bajada}</p>
    </div>

    <ul class="rejilla-tarjetas rejilla-tarjetas--cuatro" role="list">
      {
        servicios.tarjetas.map((tarjeta, indice) => (
          <li class="tarjeta" data-reveal style={`--retardo: ${indice * 80}ms`}>
            <span class="tarjeta__icono" aria-hidden="true">
              <Icon name={tarjeta.icono as any} size={22} />
            </span>
            <h3>{tarjeta.titulo}</h3>
            <p class="tarjeta__texto">{tarjeta.texto}</p>
            <a class="enlace-flecha tarjeta__enlace" href={tarjeta.href}>
              Saber más <span aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="nota-alcance" data-reveal>
      <h3>{servicios.alcance.titulo}</h3>
      <p>{servicios.alcance.texto}</p>
    </div>
  </div>
</section>
