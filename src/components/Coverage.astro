---
import { cobertura } from '../data/contenido';
import { site } from '../data/site';
---

<section class="seccion seccion--blanca" id="cobertura" aria-labelledby="cobertura-titulo">
  <div class="contenedor">
    <div class="encabezado" data-reveal>
      <h2 id="cobertura-titulo">{cobertura.titulo}</h2>
      <p>{cobertura.bajada}</p>
    </div>

    <div class="cobertura__acordeon" data-reveal>
      <details class="catalogo-servicios__grupo">
        <summary>
          <span><strong>Profesionales disponibles</strong><small>Conoce quiénes pueden acompañar a tu familiar.</small></span>
          <span class="catalogo-servicios__signo" aria-hidden="true">+</span>
        </summary>
        <ul class="lista-simple">
          {cobertura.profesionales.map((profesional) => <li>{profesional}</li>)}
        </ul>
      </details>
      <details class="catalogo-servicios__grupo">
        <summary>
          <span><strong>Horarios de atención</strong><small>Elige la modalidad que mejor se adapta a tu familia.</small></span>
          <span class="catalogo-servicios__signo" aria-hidden="true">+</span>
        </summary>
        <ul class="lista-simple">
          {cobertura.turnos.map((turno) => <li>{turno}</li>)}
        </ul>
      </details>
      <details class="catalogo-servicios__grupo">
        <summary>
          <span><strong>Comunas atendidas</strong><small>Revisa si llegamos a tu comuna.</small></span>
          <span class="catalogo-servicios__signo" aria-hidden="true">+</span>
        </summary>
        <ul class="lista-simple">
          {site.areaServida.map((comuna) => <li>{comuna}</li>)}
        </ul>
      </details>
    </div>
  </div>
</section>
