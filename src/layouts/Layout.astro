---
import '../styles/fonts.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** Ruta canónica. Por defecto, la ruta actual. */
  canonical?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  noindex?: boolean;
  /** Bloque(s) JSON-LD adicionales para la página. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Oculta el encabezado y el pie (páginas de confirmación). */
  sinCromo?: boolean;
}

const {
  title,
  description,
  canonical,
  ogType = 'website',
  ogImage = '/img/og-aeterna-care.jpg',
  noindex = false,
  jsonLd,
  sinCromo = false,
} = Astro.props;

const sitio = Astro.site ?? new URL(site.dominio);
const urlCanonica = new URL(canonical ?? Astro.url.pathname, sitio).href;
const urlOg = new URL(ogImage, sitio).href;

/** Google Tag Manager es la única puerta de entrada para medición. */
const medicionConfigurada = true;

const datosBase: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${sitio.origin}/#organizacion`,
  name: site.nombre,
  url: sitio.origin,
  description:
    'Cuidado y acompañamiento profesional para adultos mayores a domicilio en Santiago de Chile.',
  telephone: site.telefonoE164,
  priceRange: '$$',
  areaServed: site.areaServida.map((comuna) => ({ '@type': 'City', name: comuna })),
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.comuna,
    addressRegion: site.region,
    addressCountry: site.pais,
    ...(site.direccion ? { streetAddress: site.direccion } : {}),
  },
  // Sin email en JSON-LD: la dirección se mantiene ofuscada para evitar bots.
  ...(Object.values(site.redes).some(Boolean)
    ? { sameAs: Object.values(site.redes).filter(Boolean) }
    : {}),
};

const bloquesExtra = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="es-CL">
  <head>
    <!-- Consent Mode debe definirse antes de cargar Google Tag Manager. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { window.dataLayer.push(arguments); }
      gtag('consent', 'default', {
        ad_storage: 'denied',
        analytics_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        functionality_storage: 'granted',
        security_storage: 'granted',
        wait_for_update: 500
      });
      window.dataLayer.push({
        'gtm.start': new Date().getTime(),
        event: 'gtm.js'
      });
    </script>
    <!-- Google Tag Manager: contenedor global del sitio. -->
    <script is:inline async src="https://www.googletagmanager.com/gtm.js?id=GTM-5SDQ9M5Q"></script>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={urlCanonica} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <meta name="robots" content="index, follow, max-image-preview:large" />}

    <meta name="theme-color" content="#EAF6F1" />
    <meta name="color-scheme" content="light" />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content={site.nombre} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={urlCanonica} />
    <meta property="og:image" content={urlOg} />
    <meta property="og:image:alt" content={`${site.nombre}: cuidado de adultos mayores en casa`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={urlOg} />

    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-192.png" sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link
      rel="preload"
      href="/fonts/manrope-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/instrument-serif-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Marca el documento como "con JS" antes de pintar, para que las
         animaciones de entrada solo oculten contenido cuando exista JS. -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(datosBase)} />
    {
      bloquesExtra.map((bloque) => (
        <script type="application/ld+json" set:html={JSON.stringify(bloque)} />
      ))
    }
  </head>
  <body>
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-5SDQ9M5Q"
        height="0"
        width="0"
        style="display:none;visibility:hidden"
        title="Google Tag Manager"
      ></iframe>
    </noscript>
    <a class="salto-a-contenido" href="#contenido">Saltar al contenido</a>

    {!sinCromo && <Header ruta={Astro.url.pathname} />}

    <main id="contenido">
      <slot />
    </main>

    {!sinCromo && <Footer />}

    <FloatingWhatsApp />

    {/* Consentimiento y eventos: las etiquetas de medición viven en Google Tag Manager. */}
    <script>
      const clave = 'aeterna-consentimiento-medicion';
      const banner = document.getElementById('consentimiento');
      const consentimiento = localStorage.getItem(clave);
      const actualizarConsentimiento = (aceptado: boolean) => {
        window.gtag?.('consent', 'update', {
          ad_storage: aceptado ? 'granted' : 'denied',
          analytics_storage: aceptado ? 'granted' : 'denied',
          ad_user_data: aceptado ? 'granted' : 'denied',
          ad_personalization: aceptado ? 'granted' : 'denied'
        });
      };

      if (consentimiento === 'aceptado' || consentimiento === 'rechazado') {
        actualizarConsentimiento(consentimiento === 'aceptado');
        banner?.setAttribute('data-visible', 'false');
      } else {
        banner?.setAttribute('data-visible', 'true');
      }

      document.getElementById('consentimiento-aceptar')?.addEventListener('click', () => {
        localStorage.setItem(clave, 'aceptado');
        actualizarConsentimiento(true);
        banner?.setAttribute('data-visible', 'false');
      });
      document.getElementById('consentimiento-rechazar')?.addEventListener('click', () => {
        localStorage.setItem(clave, 'rechazado');
        actualizarConsentimiento(false);
        banner?.setAttribute('data-visible', 'false');
      });

      const emitirEvento = (evento: string, detalle: Record<string, string>) => {
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event: evento, ...detalle });
      };

      document.addEventListener('click', (click) => {
        const elemento = (click.target as Element | null)?.closest<HTMLElement>('[data-analitica]');
        const origen = elemento?.dataset.analitica;
        if (!origen) return;

        const evento = origen.startsWith('whatsapp-')
          ? 'clic_whatsapp'
          : origen.startsWith('telefono-') || origen === 'telefono'
            ? 'clic_telefono'
            : origen.startsWith('correo')
              ? 'clic_correo'
              : 'clic_cta';

        emitirEvento(evento, { origen });
      });
    </script>

    {
      medicionConfigurada && (
        <div
          id="consentimiento"
          class="consentimiento-banner"
          data-visible="false"
          role="dialog"
          aria-label="Preferencias de medición"
        >
          <p>
            Usamos cookies de medición para entender cómo se usa el sitio. Puedes aceptarlas o
            seguir navegando sin ellas.
          </p>
          <div class="consentimiento-banner__acciones">
            <button type="button" class="btn btn--secundario" id="consentimiento-rechazar">
              Rechazar
            </button>
            <button type="button" class="btn btn--primario" id="consentimiento-aceptar">
              Aceptar
            </button>
          </div>
        </div>
      )
    }
  </body>
</html>
