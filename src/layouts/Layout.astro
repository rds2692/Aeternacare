---
import '../styles/fonts.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** Ruta canónica. Por defecto, la ruta actual. */
  canonical?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  noindex?: boolean;
  /** Bloque(s) JSON-LD adicionales para la página. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Oculta el encabezado y el pie (páginas de confirmación). */
  sinCromo?: boolean;
}

const {
  title,
  description,
  canonical,
  ogType = 'website',
  ogImage = '/img/og-aeterna-care.jpg',
  noindex = false,
  jsonLd,
  sinCromo = false,
} = Astro.props;

const sitio = Astro.site ?? new URL(site.dominio);
const urlCanonica = new URL(canonical ?? Astro.url.pathname, sitio).href;
const urlOg = new URL(ogImage, sitio).href;

/** Hay medición configurada solo si existe al menos un ID real. */
const medicionConfigurada = Boolean(
  site.medicion.ga4 || site.medicion.metaPixel || site.medicion.googleAds,
);

const datosBase: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${sitio.origin}/#organizacion`,
  name: site.nombre,
  url: sitio.origin,
  description:
    'Cuidado y acompañamiento profesional para adultos mayores a domicilio en Santiago de Chile.',
  telephone: site.telefonoE164,
  priceRange: '$$',
  areaServed: site.areaServida.map((comuna) => ({ '@type': 'City', name: comuna })),
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.comuna,
    addressRegion: site.region,
    addressCountry: site.pais,
    ...(site.direccion ? { streetAddress: site.direccion } : {}),
  },
  ...(site.correo ? { email: site.correo } : {}),
  ...(Object.values(site.redes).some(Boolean)
    ? { sameAs: Object.values(site.redes).filter(Boolean) }
    : {}),
};

const bloquesExtra = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={urlCanonica} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <meta name="robots" content="index, follow, max-image-preview:large" />}

    <meta name="theme-color" content="#EAF6F1" />
    <meta name="color-scheme" content="light" />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content={site.nombre} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={urlCanonica} />
    <meta property="og:image" content={urlOg} />
    <meta property="og:image:alt" content={`${site.nombre}: cuidado de adultos mayores en casa`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={urlOg} />

    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-192.png" sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link
      rel="preload"
      href="/fonts/manrope-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/instrument-serif-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Marca el documento como "con JS" antes de pintar, para que las
         animaciones de entrada solo oculten contenido cuando exista JS. -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(datosBase)} />
    {
      bloquesExtra.map((bloque) => (
        <script type="application/ld+json" set:html={JSON.stringify(bloque)} />
      ))
    }
  </head>
  <body>
    <a class="salto-a-contenido" href="#contenido">Saltar al contenido</a>

    {!sinCromo && <Header ruta={Astro.url.pathname} />}

    <main id="contenido">
      <slot />
    </main>

    {!sinCromo && <Footer />}

    <FloatingWhatsApp />

    {/* Medición: solo se carga si hay IDs configurados y el visitante acepta. */}
    <script>
      import { site } from '../data/site';
      import { iniciarMedicion, hayMedicion } from '../scripts/medicion';

      if (hayMedicion(site.medicion)) {
        const clave = 'aeterna-consentimiento-medicion';
        const guardado = localStorage.getItem(clave);

        if (guardado === 'aceptado') {
          iniciarMedicion(site.medicion);
        } else if (guardado !== 'rechazado') {
          const banner = document.getElementById('consentimiento');
          banner?.setAttribute('data-visible', 'true');
          document.getElementById('consentimiento-aceptar')?.addEventListener('click', () => {
            localStorage.setItem(clave, 'aceptado');
            banner?.setAttribute('data-visible', 'false');
            iniciarMedicion(site.medicion);
          });
          document.getElementById('consentimiento-rechazar')?.addEventListener('click', () => {
            localStorage.setItem(clave, 'rechazado');
            banner?.setAttribute('data-visible', 'false');
          });
        }
      }
    </script>

    {
      medicionConfigurada && (
        <div
          id="consentimiento"
          class="consentimiento-banner"
          data-visible="false"
          role="dialog"
          aria-label="Preferencias de medición"
        >
          <p>
            Usamos cookies de medición para entender cómo se usa el sitio. Puedes aceptarlas o
            seguir navegando sin ellas.
          </p>
          <div class="consentimiento-banner__acciones">
            <button type="button" class="btn btn--secundario" id="consentimiento-rechazar">
              Rechazar
            </button>
            <button type="button" class="btn btn--primario" id="consentimiento-aceptar">
              Aceptar
            </button>
          </div>
        </div>
      )
    }
  </body>
</html>
