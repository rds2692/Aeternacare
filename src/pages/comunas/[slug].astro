---
import Layout from '../../layouts/Layout.astro';
import { paginasComunas, paginaComuna } from '../../data/landing';
import { paginasServicios } from '../../data/landing';
import { whatsappLink } from '../../data/site';

export function getStaticPaths() {
  return paginasComunas.map((comuna) => ({
    params: { slug: comuna.slug },
    props: { comuna: comuna.nombre },
  }));
}

const { comuna: nombre } = Astro.props;
const comuna = paginaComuna(nombre);
if (!comuna) throw new Error(`Comuna no encontrada: ${nombre}`);

const titulo = `Cuidados a domicilio en ${nombre} | Aeterna Care`;
const descripcion = `Consulta por cuidadoras, TENS y enfermería a domicilio en ${nombre}. Confirmamos disponibilidad, horario y perfil profesional antes de agendar.`;
const canonical = `/comunas/${comuna.slug}/`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: `Cuidados a domicilio en ${nombre}`,
    serviceType: 'Cuidado y acompañamiento de adultos mayores a domicilio',
    areaServed: { '@type': 'City', name: nombre },
    provider: { '@id': 'https://www.aeternacare.cl/#organizacion' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://www.aeternacare.cl/' },
      { '@type': 'ListItem', position: 2, name: 'Comunas', item: 'https://www.aeternacare.cl/comunas/' },
      { '@type': 'ListItem', position: 3, name: nombre, item: `https://www.aeternacare.cl${canonical}` },
    ],
  },
];
---

<Layout title={titulo} description={descripcion} canonical={canonical} jsonLd={jsonLd}>
  <section class="cabecera-pagina seccion--menta">
    <div class="contenedor">
      <nav aria-label="Ruta de navegación">
        <ol class="migas">
          <li><a href="/">Inicio</a></li>
          <li><a href="/#cobertura">Cobertura</a></li>
          <li aria-current="page">{nombre}</li>
        </ol>
      </nav>
      <div class="cabecera-pagina__inner">
        <p class="eyebrow">Atención domiciliaria en Santiago</p>
        <h1>Cuidados a domicilio en {nombre}</h1>
        <p>
          Consulta por cuidadoras, TENS, enfermería y técnicos kinesiólogos. Antes de agendar,
          confirmamos la disponibilidad, el horario y el tipo de apoyo que corresponde.
        </p>
        <div class="grupo-botones">
          <a
            class="btn btn--primario"
            data-analitica={`cotizar-comuna-${comuna.slug}`}
            href={`/contacto/?comuna=${comuna.slug}&origen=comuna-${comuna.slug}#formulario-contacto`}
          >Cotizar en {nombre}</a>
          <a
            class="btn btn--whatsapp"
            href={whatsappLink(`Hola, quiero cotizar cuidados a domicilio en ${nombre}. El horario que necesito es: `)}
            target="_blank"
            rel="noopener"
            data-analitica={`whatsapp-cotizar-comuna-${comuna.slug}`}
          >Cotizar por WhatsApp</a>
        </div>
      </div>
    </div>
  </section>

  <section class="seccion seccion--blanca">
    <div class="contenedor landing__contenido">
      <div>
        <h2>Qué revisamos antes de agendar</h2>
        <p>
          Conversamos contigo sobre la rutina de tu familiar, las horas de apoyo que necesita y
          las tareas que deben quedar incluidas en el servicio.
        </p>
        <p>{comuna.orientacion}</p>
        <p>
          También puedes consultar por turnos diurnos, nocturnos o de 24 horas, sujetos a
          disponibilidad y evaluación de la necesidad.
        </p>
      </div>
      <aside class="nota-alcance">
        <h3>Antes de agendar</h3>
        <p>El valor final se confirma según el servicio, horario, comuna, complejidad y disponibilidad.</p>
      </aside>
    </div>
  </section>

  <section class="seccion seccion--suave" aria-labelledby="servicios-comuna-titulo">
    <div class="contenedor">
      <div class="encabezado"><h2 id="servicios-comuna-titulo">Servicios que puedes consultar en {nombre}</h2><p>La disponibilidad se confirma antes de agendar.</p></div>
      <div class="rejilla-tarjetas rejilla-tarjetas--cuatro">
        {paginasServicios.map((servicio) => (
          <article class="tarjeta">
            <h3>{servicio.nombre}</h3>
            <p class="tarjeta__texto">{servicio.descripcion}</p>
            <div class="grupo-botones">
              <a class="enlace-flecha" href={`/servicios/${servicio.slug}/`}>Ver servicio <span aria-hidden="true">→</span></a>
              <a
                class="enlace-flecha"
                href={`/contacto/?servicio=${servicio.cotizacion}&comuna=${comuna.slug}&origen=comuna-${comuna.slug}-${servicio.slug}#formulario-contacto`}
                data-analitica={`cotizar-comuna-${comuna.slug}-${servicio.slug}`}
                data-servicio={servicio.cotizacion}
              >Cotizar <span aria-hidden="true">→</span></a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="seccion seccion--blanca" aria-labelledby="faq-comuna-titulo">
    <div class="contenedor landing__faq">
      <div class="encabezado"><h2 id="faq-comuna-titulo">Preguntas frecuentes sobre cuidados en {nombre}</h2></div>
      <details class="faq"><summary>¿Qué tipo de turnos puedo consultar?</summary><p>Turnos diurnos, nocturnos y de 24 horas, sujetos a disponibilidad y evaluación de la necesidad.</p></details>
      <details class="faq"><summary>¿El valor es el mismo para todas las comunas?</summary><p>Los valores publicados son referenciales. El valor final se confirma considerando comuna, horario, tipo de profesional y alcance del servicio.</p></details>
      <details class="faq"><summary>¿Cómo solicito una cotización?</summary><p>Completa el formulario con el servicio, horario y comuna, o escribe por WhatsApp indicando que necesitas atención en {nombre}.</p></details>
    </div>
  </section>

  <section class="seccion seccion--menta">
    <div class="contenedor cierre">
      <h2>¿Buscas apoyo para tu familiar en {nombre}?</h2>
      <p>Cuéntanos qué necesitas y revisaremos contigo los siguientes pasos.</p>
      <a
        class="btn btn--primario btn--grande"
        data-analitica={`cotizar-comuna-cierre-${comuna.slug}`}
        href={`/contacto/?comuna=${comuna.slug}&origen=comuna-cierre-${comuna.slug}#formulario-contacto`}
      >Solicitar cotización</a>
    </div>
  </section>
</Layout>
