---
import Layout from '../../layouts/Layout.astro';
import { paginasServicios } from '../../data/landing';
import { site, whatsappLink } from '../../data/site';

export function getStaticPaths() {
  return paginasServicios.map((servicio) => ({ params: { slug: servicio.slug }, props: { servicio } }));
}

const { servicio } = Astro.props;
const canonical = `/servicios/${servicio.slug}/`;
const titulo = `${servicio.titulo} | Aeterna Care`;
const descripcion = `${servicio.descripcion} Cotiza disponibilidad, horario y valor referencial con Aeterna Care.`;
const cotizarHref = `/contacto/?servicio=${servicio.cotizacion}&origen=servicio-${servicio.slug}#formulario-contacto`;
const guiasRelacionadas: Record<string, Array<{ href: string; titulo: string }>> = {
  'cuidadoras-adulto-mayor': [
    { href: '/blog/elegir-cuidadora-adulto-mayor/', titulo: 'Cómo elegir una cuidadora' },
    { href: '/blog/turnos-cuidado-adulto-mayor/', titulo: 'Comparar turnos de cuidado' },
  ],
  'tens-a-domicilio': [
    { href: '/blog/cuidadora-tens-o-enfermera/', titulo: 'Diferencias entre cuidadora, TENS y enfermería' },
    { href: '/blog/cuidado-movilidad-reducida/', titulo: 'Organizar el cuidado con movilidad reducida' },
  ],
  'enfermeria-a-domicilio': [
    { href: '/blog/preguntas-enfermeria-domicilio/', titulo: 'Qué preguntar antes de contratar enfermería' },
    { href: '/blog/preparar-hogar-despues-hospitalizacion/', titulo: 'Preparar el regreso a casa tras una hospitalización' },
  ],
  'tecnicos-kinesiologos-a-domicilio': [
    { href: '/blog/cuidado-movilidad-reducida/', titulo: 'Organizar el cuidado con movilidad reducida' },
    { href: '/blog/preparar-hogar-despues-hospitalizacion/', titulo: 'Preparar el regreso a casa tras una hospitalización' },
  ],
};
const guias = guiasRelacionadas[servicio.slug] ?? [];
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: servicio.titulo,
    serviceType: servicio.nombre,
    areaServed: site.areaServida.map((comuna) => ({ '@type': 'City', name: comuna })),
    provider: { '@id': 'https://www.aeternacare.cl/#organizacion' },
    description: servicio.descripcion,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://www.aeternacare.cl/' },
      { '@type': 'ListItem', position: 2, name: 'Servicios', item: 'https://www.aeternacare.cl/#servicios' },
      { '@type': 'ListItem', position: 3, name: servicio.nombre, item: `https://www.aeternacare.cl${canonical}` },
    ],
  },
];
---

<Layout title={titulo} description={descripcion} canonical={canonical} jsonLd={jsonLd}>
  <section class="cabecera-pagina seccion--menta">
    <div class="contenedor">
      <nav aria-label="Ruta de navegación">
        <ol class="migas">
          <li><a href="/">Inicio</a></li>
          <li><a href="/#servicios">Servicios</a></li>
          <li aria-current="page">{servicio.nombre}</li>
        </ol>
      </nav>
      <div class="cabecera-pagina__inner">
        <p class="eyebrow">Aeterna Care · Cuidados en casa</p>
        <h1>{servicio.titulo}</h1>
        <p>{servicio.descripcion}</p>
        <div class="grupo-botones">
          <a
            class="btn btn--primario"
            data-analitica={`cotizar-servicio-${servicio.slug}`}
            data-servicio={servicio.cotizacion}
            href={cotizarHref}
          >Cotizar este servicio</a>
          <a
            class="btn btn--whatsapp"
            href={whatsappLink(`Hola, quiero cotizar ${servicio.nombre.toLowerCase()} a domicilio. Mi comuna es: `)}
            target="_blank"
            rel="noopener"
            data-analitica={`whatsapp-cotizar-servicio-${servicio.slug}`}
            data-servicio={servicio.cotizacion}
          >Cotizar por WhatsApp</a>
        </div>
      </div>
    </div>
  </section>

  <section class="seccion seccion--blanca">
    <div class="contenedor landing__contenido">
      <div>
        <h2>¿Qué puedes consultar?</h2>
        <p>{servicio.descripcion} Antes de comenzar, confirmamos con la familia el alcance del apoyo, el horario y la forma de comunicación.</p>
        <ul class="lista-simple landing__lista">
          {servicio.incluye.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <aside class="nota-alcance">
        <h3>Valor referencial</h3>
        <p>{servicio.valor}</p>
        <a
          class="enlace-flecha"
          href={cotizarHref}
          data-analitica={`cotizar-servicio-valor-${servicio.slug}`}
          data-servicio={servicio.cotizacion}
        >Solicitar cotización <span aria-hidden="true">→</span></a>
      </aside>
    </div>
  </section>

  <section class="seccion seccion--suave" aria-labelledby="como-solicitar-titulo">
    <div class="contenedor">
      <div class="encabezado"><h2 id="como-solicitar-titulo">Cómo consultar por este servicio</h2><p>Cuéntanos la situación de tu familiar y revisaremos disponibilidad, alcance y valor.</p></div>
      <ol class="proceso proceso--tres">
        <li class="paso"><h3>Nos contactas</h3><p>Indicas qué servicio buscas, la comuna y el horario aproximado.</p></li>
        <li class="paso"><h3>Revisamos la necesidad</h3><p>Conversamos contigo para entender el apoyo que corresponde.</p></li>
        <li class="paso"><h3>Confirmamos la atención</h3><p>Te informamos disponibilidad, alcance y valor antes de agendar.</p></li>
      </ol>
    </div>
  </section>

  <section class="seccion seccion--suave" aria-labelledby="guias-servicio-titulo">
    <div class="contenedor">
      <div class="encabezado">
        <h2 id="guias-servicio-titulo">Guías relacionadas</h2>
        <p>Información práctica para preparar la conversación y comparar opciones.</p>
      </div>
      <ul class="lista-simple">
        {guias.map((guia) => <li><a href={guia.href}>{guia.titulo}</a></li>)}
        <li><a href="/blog/cuanto-cuesta-cuidado-adulto-mayor-santiago/">Revisar valores referenciales y factores de cotización</a></li>
      </ul>
    </div>
  </section>

  <section class="seccion seccion--blanca">
    <div class="contenedor cierre">
      <h2>{servicio.cierreCotizacion}</h2>
      <p>Indícanos la comuna, el horario y el apoyo que necesita. Revisaremos la alternativa y el valor antes de agendar.</p>
      <a
        class="btn btn--primario btn--grande"
        data-analitica={`cotizar-servicio-cierre-${servicio.slug}`}
        data-servicio={servicio.cotizacion}
        href={cotizarHref}
      >Solicitar cotización</a>
    </div>
  </section>
</Layout>
