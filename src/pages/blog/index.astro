---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import Photo from '../../components/Photo.astro';
import { site } from '../../data/site';
import { guiaSEO } from '../../data/contenido';

const entradas = (await getCollection('blog')).sort(
  (a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf(),
);

const titulo = 'Cuidado de adultos mayores: guías para familias | Aeterna Care';
const descripcion =
  'Guías prácticas sobre cuidado domiciliario de adultos mayores en Chile: cómo elegir, qué preguntar y cómo preparar el hogar.';

const formatoFecha = new Intl.DateTimeFormat('es-CL', { dateStyle: 'long' });

const migas = [
  { href: '/', label: 'Inicio' },
  { href: '/blog/', label: 'Blog' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Blog de Aeterna Care',
  url: `${site.dominio}/blog/`,
  blogPost: entradas.map((entrada) => ({
    '@type': 'BlogPosting',
    headline: entrada.data.title,
    datePublished: entrada.data.fecha.toISOString().slice(0, 10),
    url: `${site.dominio}/blog/${entrada.id}/`,
  })),
};
---

<Layout title={titulo} description={descripcion} canonical="/blog/" jsonLd={jsonLd}>
  <section class="cabecera-pagina seccion--menta">
    <div class="contenedor">
      <nav aria-label="Ruta de navegación">
        <ol class="migas">
          {migas.map((miga) => <li><a href={miga.href}>{miga.label}</a></li>)}
          <li aria-current="page">Blog</li>
        </ol>
      </nav>
      <div class="cabecera-pagina__inner cabecera-pagina__inner--editorial">
        <div class="cabecera-pagina__texto">
          <h1>Guías para cuidar mejor</h1>
          <p>
            Guías para elegir cuidadora, TENS o enfermería, organizar turnos y preparar el cuidado de
            una persona mayor en casa.
          </p>
        </div>

        <Photo
          class="cabecera-pagina__figura"
          base="editorial-paseo-barrio"
          widths={[800, 1200, 1600]}
          width={1600}
          height={1200}
          sizes="(max-width: 899px) 92vw, 40vw"
          alt="Una cuidadora camina junto a una mujer mayor con bastón por un barrio residencial de Santiago."
          title="Acompañamiento y vida cotidiana"
          loading="eager"
          delay={80}
        />
      </div>
    </div>
  </section>

  <section class="seccion seccion--suave" aria-labelledby="temas-guia">
    <div class="contenedor">
      <div class="encabezado"><h2 id="temas-guia">Temas para empezar</h2><p>Respuestas prácticas a dudas frecuentes sobre el cuidado en casa.</p></div>
      <ul class="lista-simple">
        {guiaSEO.map((guia) => <li><a href={guia.href}>{guia.titulo}</a></li>)}
      </ul>
    </div>
  </section>

  <section class="seccion seccion--blanca">
    <div class="contenedor">
      <ul class="entrada-lista" role="list">
        {
          entradas.map((entrada, indice) => (
            <li class="entrada" data-reveal style={`--retardo: ${indice * 80}ms`}>
              <p class="entrada__meta">
                <time datetime={entrada.data.fecha.toISOString()}>
                  {formatoFecha.format(entrada.data.fecha)}
                </time>
                <span>{entrada.data.lectura} de lectura</span>
              </p>
              <h2>
                <a href={`/blog/${entrada.id}/`}>{entrada.data.title}</a>
              </h2>
              <p>{entrada.data.description}</p>
              <p>
                <a class="btn btn--fantasma" href={`/blog/${entrada.id}/`}>
                  Leer la guía
                  <Icon name="flecha" size={18} />
                </a>
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Layout>

<script>
  import { iniciarReveals } from '../../scripts/reveal';
  iniciarReveals();
</script>
