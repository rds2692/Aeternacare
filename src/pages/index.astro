---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ContactSection from '../components/ContactSection.astro';
import Philosophy from '../components/Philosophy.astro';
import Services from '../components/Services.astro';
import ServiceCatalog from '../components/ServiceCatalog.astro';
import Coverage from '../components/Coverage.astro';
import Trust from '../components/Trust.astro';
import Process from '../components/Process.astro';
import Testimonials from '../components/Testimonials.astro';
import FinalCTA from '../components/FinalCTA.astro';
import UrgencyCTA from '../components/UrgencyCTA.astro';
import { site } from '../data/site';

const titulo = 'Cuidado de adulto mayor a domicilio en Santiago | Aeterna Care';
const descripcion =
  'Cotiza cuidadoras, TENS y enfermería a domicilio para adultos mayores en Santiago. Revisa valores y solicita una propuesta según comuna, horario y necesidades.';

const servicioJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Cuidado y acompañamiento de adultos mayores a domicilio',
  serviceType: 'Cuidado domiciliario de adultos mayores',
  areaServed: site.areaServida.map((comuna) => ({ '@type': 'City', name: comuna })),
  provider: { '@id': 'https://www.aeternacare.cl/#organizacion' },
  description:
    'Acompañamiento, apoyo en actividades diarias y supervisión del bienestar en el hogar, con personal TENS y enfermería según el caso.',
};
---

<Layout title={titulo} description={descripcion} canonical="/" jsonLd={servicioJsonLd}>
  <Hero />
  <ContactSection origen="inicio" />
  <Philosophy />
  <Services />
  <ServiceCatalog origen="inicio-valores" />
  <Coverage />
  <Trust />
  <Process />
  <Testimonials />
  <UrgencyCTA />
  <FinalCTA />
</Layout>

<script>
  import { iniciarReveals } from '../scripts/reveal';

  iniciarReveals();
</script>
