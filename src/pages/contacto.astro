---
import Layout from '../layouts/Layout.astro';
import ContactSection from '../components/ContactSection.astro';
import Pending from '../components/Pending.astro';
import { site, whatsappLink, telLink } from '../data/site';

const titulo = 'Contacto | Aeterna Care';
const descripcion =
  'Escríbenos por WhatsApp o completa el formulario y te orientamos sobre el cuidado que necesita tu familiar en Santiago.';

const migas = [
  { href: '/', label: 'Inicio' },
  { href: '/contacto/', label: 'Contacto' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: titulo,
    url: `${site.dominio}/contacto/`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: migas.map((miga, indice) => ({
      '@type': 'ListItem',
      position: indice + 1,
      name: miga.label,
      item: `${site.dominio}${miga.href}`,
    })),
  },
];
---

<Layout title={titulo} description={descripcion} canonical="/contacto/" jsonLd={jsonLd}>
  <section class="cabecera-pagina seccion--menta">
    <div class="contenedor">
      <nav aria-label="Ruta de navegación">
        <ol class="migas">
          {migas.map((miga) => <li><a href={miga.href}>{miga.label}</a></li>)}
          <li aria-current="page">Contacto</li>
        </ol>
      </nav>
      <div class="cabecera-pagina__inner">
        <h1>Hablemos sobre las necesidades de tu familiar</h1>
        <p>
          Cuéntanos brevemente la situación y te orientamos sobre la alternativa de cuidado más
          adecuada. Sin compromiso y sin tecnicismos innecesarios.
        </p>
      </div>
    </div>
  </section>

  <ContactSection compacto />

  <section class="seccion seccion--menta">
    <div class="contenedor">
      <div class="encabezado" data-reveal>
        <h2>Otros canales</h2>
      </div>

      <dl class="datos-contacto" data-reveal style="--retardo: 80ms">
        <div>
          <dt>Teléfono</dt>
          <dd>
            <a href={telLink} data-analitica="telefono-contacto">{site.telefonoVisible}</a>
          </dd>
        </div>
        <div>
          <dt>WhatsApp</dt>
          <dd>
            <a href={whatsappLink()} target="_blank" rel="noopener" data-analitica="whatsapp-contacto">
              Escribir por WhatsApp
            </a>
          </dd>
        </div>
        <div>
          <dt>Correo</dt>
          <dd>
            {
              site.correo ? (
                <a href={`mailto:${site.correo}`}>{site.correo}</a>
              ) : (
                <Pending campo="correo corporativo" />
              )
            }
          </dd>
        </div>
        <div>
          <dt>Horario de atención</dt>
          <dd>{site.horario || <Pending campo="horario de atención" />}</dd>
        </div>
        <div>
          <dt>Cobertura</dt>
          <dd>
            {site.direccion || <Pending campo="dirección" />}
            <br />
            {site.areaServida.slice(0, 4).join(' · ')} y otras comunas de Santiago.
          </dd>
        </div>
      </dl>

      <p class="nota-urgencia">
        Ante una urgencia médica llama al 131. Este sitio no reemplaza la atención de emergencia.
      </p>
    </div>
  </section>
</Layout>

<script>
  import { iniciarReveals } from '../scripts/reveal';
  iniciarReveals();
</script>
